# Omnifin __OMNIFIN_RELEASE_VERSION__
# Copy this file to .env, replace every example or empty value, and keep it mode 0600.

# This immutable image digest is generated from the verified release candidate.
OMNIFIN_IMAGE=__OMNIFIN_IMAGE_REFERENCE__

# Public HTTPS origin presented by the maintained reverse proxy.
OMNIFIN_BASE_URL=https://omnifin.example.net
OMNIFIN_WEB_PORT=3000
OMNIFIN_WEB_TRUST_PROXY_HOPS=1
OMNIFIN_SECURE_COOKIES=true
OMNIFIN_INSECURE_LOOPBACK_PREVIEW=false

# Use ten-foot only when the interface is primarily viewed from television distance.
OMNIFIN_DISPLAY_PROFILE=standard
OMNIFIN_LOG_LEVEL=info

# Jellyfin used for sign-in, account pairing, playback, and the first administrator.
OMNIFIN_JELLYFIN_URL=https://jellyfin.example.net
OMNIFIN_JELLYFIN_INSECURE_HTTP_APPROVED=false

# Generate distinct values with `openssl rand -base64 32` and
# `openssl rand -base64 48`. Store both outside the database backup too.
OMNIFIN_ENCRYPTION_KEY=
OMNIFIN_RECOVERY_SECRET=

# Create this directory as private storage owned by numeric user and group 65532.
OMNIFIN_BACKUP_DIRECTORY=./backups
