# Public origins
OMNIFIN_BASE_URL=http://localhost:3000
OMNIFIN_GATEWAY_URL=http://127.0.0.1:4000

# Runtime
NEXT_TELEMETRY_DISABLED=1
STORYBOOK_DISABLE_TELEMETRY=1
TURBO_TELEMETRY_DISABLED=1
OMNIFIN_HOST=127.0.0.1
OMNIFIN_PORT=4000
OMNIFIN_DATABASE_URL=./data/omnifin.db
OMNIFIN_LOG_LEVEL=info
OMNIFIN_SECURE_COOKIES=false
OMNIFIN_TRUST_PROXY_HOPS=0

# Use ten-foot for television-distance typography, focus, and control sizing.
OMNIFIN_DISPLAY_PROFILE=standard

# Generate exactly 32 random bytes and encode them as base64. For a future
# supported deployment, mount this value from a Docker secret instead of
# storing it in an env file.
OMNIFIN_ENCRYPTION_KEY=
OMNIFIN_ENCRYPTION_KEY_FILE=

# Phase 0 provider discovery only. Supplying a Jellyfin URL makes safe metadata
# visible to the gateway, but does not enable Jellyfin sign-in, Quick Connect,
# account pairing, libraries, playback, or administration. OIDC and connector
# administration arrive in Phase 1; there is no Phase 0 OIDC bootstrap variable.
# Use HTTPS. A private-network HTTP endpoint is rejected unless the separate,
# service-specific acknowledgement below is deliberately set to true.
OMNIFIN_JELLYFIN_URL=
OMNIFIN_JELLYFIN_INSECURE_HTTP_APPROVED=false

# Reserved for the Phase 1 break-glass flow. Phase 0 can load the secret safely,
# but exposes no recovery endpoint, so setting it does not grant recovery access.
# Prefer the file variant once the recovery flow is implemented and verified.
OMNIFIN_RECOVERY_SECRET=
OMNIFIN_RECOVERY_SECRET_FILE=

# Synthetic interface data for local visual review only. This does not enable
# authentication, connectors, media operations, or a supported deployment.
OMNIFIN_DEMO_MODE=false
