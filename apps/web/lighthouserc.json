{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "settings": { "budgetsPath": "./lighthouse-budget.json" },
      "startServerCommand": "OMNIFIN_DEMO_MODE=true OMNIFIN_TEST_MODE=true pnpm start",
      "startServerReadyPattern": "Ready",
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/?test-view=onboarding",
        "http://127.0.0.1:3000/login",
        "http://127.0.0.1:3000/login?test-view=unconfigured"
      ]
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:performance": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "performance-budget": "error",
        "total-blocking-time": ["error", { "maxNumericValue": 200 }]
      }
    },
    "upload": { "outputDir": ".lighthouseci", "target": "filesystem" }
  }
}
