{
  "name": "@omnifin/web",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next build",
    "build:storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "clean": "rm -rf .lighthouseci .next coverage playwright-report storybook-static test-results",
    "dev": "cross-env NODE_ENV=development NEXT_TELEMETRY_DISABLED=1 next dev --turbopack --hostname 127.0.0.1",
    "lighthouse": "lhci autorun",
    "lint": "eslint --max-warnings=0 .",
    "start": "cross-env NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "test": "vitest run --project=unit --coverage",
    "test:a11y": "playwright test tests/a11y",
    "test:e2e": "playwright test tests/e2e",
    "test:oidc-rewrite": "playwright test --config=playwright.oidc.config.ts",
    "test:storybook": "cross-env STORYBOOK_DISABLE_TELEMETRY=1 vitest run --project=storybook",
    "test:visual": "cross-env OMNIFIN_VISUAL_TEST=true playwright test tests/visual",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@omnifin/contracts": "workspace:*",
    "@tanstack/react-query": "5.101.4",
    "hls.js": "1.6.16",
    "lucide-react": "1.26.0",
    "motion": "12.42.2",
    "next": "16.2.11",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.61.1",
    "@storybook/addon-a11y": "10.5.4",
    "@storybook/addon-docs": "10.5.4",
    "@storybook/addon-vitest": "10.5.4",
    "@storybook/nextjs-vite": "10.5.4",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "aria-query": "5.3.2",
    "cross-env": "10.1.0",
    "jsdom": "29.1.1",
    "postcss": "8.5.18",
    "storybook": "10.5.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
